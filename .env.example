# Copy values into your shell environment. Do not commit a real .env file.
# This project never loads a local .env file; configuration is process-env only.

# Application/research PostgreSQL database — REQUIRED for DB-backed CLI operations.
# Replace USER and PASSWORD; do not put credentials in this file.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/newcoin

# Test-only PostgreSQL database — REQUIRED to execute PostgreSQL integration tests.
# Safe local peer-auth example used by the verified macOS run:
NEWCOIN_TEST_DATABASE_URL=postgresql+asyncpg://localhost/newcoin_test

# Execution is paper-only. Any other value is rejected before I/O.
EXECUTION_MODE=paper

# HTTP client — optional; defaults shown.
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_ATTEMPTS=4
HTTP_BACKOFF_SECONDS=0.25
HTTP_RATE_LIMIT_PER_SECOND=8

# Public/read-only collectors. Defaults shown; no key is needed for Binance,
# Raydium, or GeckoTerminal. BIRDEYE_API_KEY is required only for live
# collect-once/poll Solana discovery; leave it empty for unit tests/offline smoke.
BINANCE_BASE_URL=https://api.binance.com
BIRDEYE_BASE_URL=https://public-api.birdeye.so
BIRDEYE_API_KEY=
BIRDEYE_CHAIN=solana
RAYDIUM_POOL_BASE_URL=https://api-v3.raydium.io
RAYDIUM_QUOTE_BASE_URL=https://transaction-v1.raydium.io
GECKO_BASE_URL=https://api.geckoterminal.com/api/v2

# Paper broker — optional deterministic simulation controls.
PAPER_FEE_BPS=10
PAPER_SLIPPAGE_BPS=25
PAPER_MAX_FILL_LIQUIDITY_FRACTION=0.10

# Risk limits — optional paper-simulation controls.
RISK_MAX_NOTIONAL=1000
RISK_MAX_POSITION_SIZE=500
RISK_MAX_OPEN_POSITIONS=3
RISK_MAX_DRAWDOWN=0.25
RISK_MIN_LIQUIDITY=5000

# Optional polling/report/log controls.
POLL_INTERVAL_SECONDS=60
REPORTS_DIR=artifacts
LOG_LEVEL=INFO
